  originalText: "<size=33><b>\u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062D\u0643\u0627\u0645
    \u0644\u0645\u0646\u0635\u0629 \" \u0631\u0627\u0639\u064A \u0627\u0644\u0646\u0638\u0631-\u0644\u0639\u0628\u0629
    \u0633\u0646\u0627\u0645\"</b></size>\n\r\n(\u0631\u0627\u0639\u064A \u0627\u0644\u0646\u0638\u0631)
    \u0647\u064A \u0645\u0646\u0635\u0629 \u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A\u0629
    \u0645\u0645\u0644\u0648\u0643\u0629 \u0644\u0646\u0627\u062F\u064A \u0627\u0644\u0625\u0628\u0644
    \u0648\u062A\u0639\u062A\u0645\u062F \u0641\u064A \u0639\u0645\u0644\u0647\u0627
    \u0639\u0644\u0649 \u0625\u0642\u0627\u0645\u0629 \u0623\u0646\u0634\u0637\u0629
    \u062A\u0631\u0641\u064A\u0647\u064A\u0629 \u062A\u0641\u0627\u0639\u0644\u064A\u0629
    \u0628\u0627\u0644\u062A\u0632\u0627\u0645\u0646 \u0645\u0639 \u0645\u0647\u0631\u062C\u0627\u0646
    \u0627\u0644\u0645\u0644\u0643 \u0639\u0628\u062F \u0627\u0644\u0639\u0632\u064A\u0632
    \u0644\u0644\u0625\u0628\u0644 \u0648\u0645\u0633\u0627\u0628\u0642\u0627\u062A
    \u0648\u0641\u0639\u0627\u0644\u064A\u0627\u062A \u0646\u0627\u062F\u064A \u0627\u0644\u0625\u0628\u0644.\r\n\u064A\u0642\u0635\u062F
    \u0628\u0627\u0644\u0645\u0635\u0637\u0644\u062D\u0627\u062A \u0645\u062A\u0649
    \u0645\u0627 \u0648\u0631\u062F\u062A \u0641\u064A \u0647\u0630\u0647 \u0627\u0644\u0627\u062A\u0641\u0627\u0642\u064A\u0629
    \u2013 \u0627\u062A\u0641\u0627\u0642\u064A\u0629 \u0627\u0644\u0634\u0631\u0648\u0637
    \u0648\u0627\u0644\u0623\u062D\u0643\u0627\u0645 - \u0645\u0627 \u064A\u0644\u064A:\n\r\n\u2022\t\u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645
    \u0623\u0648 \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645\u064A\u0646: \u0627\u0644\u0623\u0634\u062E\u0627\u0635
    \u0627\u0644\u0630\u064A\u0646 \u0642\u0627\u0645\u0648\u0627 \u0628\u0627\u0644\u062F\u062E\u0648\u0644
    \u0623\u0648 \u0627\u0644\u062A\u0633\u062C\u064A\u0644 \u0641\u064A \u0627\u0644\u0645\u0646\u0635\u0629
    \u0623\u0648 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0641\u064A \u0623\u064A\u0651
    \u0645\u0646 \u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0627\u0644\u062A\u064A
    \u064A\u062A\u0645 \u0625\u0642\u0627\u0645\u062A\u0647\u0627 \u0645\u0646 \u062E\u0644\u0627\u0644
    \u0627\u0644\u0645\u0646\u0635\u0629. \r\n\u2022\t\u0627\u0644\u0623\u0646\u0634\u0637\u0629:
    \u0627\u0644\u0645\u0633\u0627\u0628\u0642\u0627\u062A \u0648\u0627\u0644\u0645\u0646\u0627\u0641\u0633\u0627\u062A
    \u0648\u0627\u0644\u0641\u0639\u0627\u0644\u064A\u0627\u062A \u0627\u0644\u062A\u0646\u0627\u0641\u0633\u064A\u0651\u0629
    \u0627\u0644\u062A\u064A \u062A\u0642\u0648\u0645 \u0628\u0647\u0627 \u0627\u0644\u0645\u0646\u0635\u0629
    \u0623\u064A\u0651\u0627\u064B \u0643\u0627\u0646 \u0646\u0648\u0639\u0647\u0627\u060C
    \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0644\u062C\u0645\u064A\u0639
    \u0645\u0627 \u064A\u062A\u0645 \u0639\u0631\u0636\u0647 \u0623\u0648 \u0625\u0636\u0627\u0641\u062A\u0647
    \u0644\u0627\u062D\u0642\u0627\u064B \u0641\u064A \u0627\u0644\u0645\u0646\u0635\u0629.\r\n\u2022\t\u0627\u0644\u0645\u0646\u0635\u0629:
    \u064A\u0642\u0635\u062F \u0628\u0647\u0627 \u0623\u064A\u0646\u0645\u0627 \u0648\u0631\u062F\u062A
    \u0641\u064A \u0647\u0630\u0647 \u0627\u0644\u0627\u062A\u0641\u0627\u0642\u064A\u0629
    \u0645\u0646\u0635\u0629 \"\u0631\u0627\u0639\u064A \u0627\u0644\u0646\u0638\u0631\"
    \u0639\u0644\u0649 \u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0627\u0644\u0643\u062A\u0631\u0648\u0646\u064A
    \u0648\u0639\u0644\u0649 \u062A\u0637\u0628\u064A\u0642\u0627\u062A \u0627\u0644\u0622\u064A\u0641\u0648\u0646
    \u0648\u0627\u0644\u0623\u0646\u062F\u0631\u0648\u064A\u062F.\r\n\u2022\t\u0627\u0644\u062D\u0633\u0627\u0628:
    \u0647\u0648 \u0627\u0644\u0633\u062C\u0644 \u2013\u0627\u0644\u0635\u0641\u062D\u0629-
    \u0627\u0644\u062E\u0627\u0635 \u0628\u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645
    \u0627\u0644\u0645\u0646\u0634\u0623 \u0645\u0646 \u0623\u062C\u0644 \u0623\u0646
    \u064A\u062A\u0645\u0643\u0646 \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645
    \u0645\u0646 \u0627\u0644\u0627\u0633\u062A\u0641\u0627\u062F\u0629 \u0645\u0646
    \u062E\u062F\u0645\u0627\u062A \u0627\u0644\u0645\u0646\u0635\u0629 \u0648\u062A\u062A\u0627\u062D
    \u0644\u0647 \u0625\u0645\u0643\u0627\u0646\u064A\u0629 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629
    \u0648\u0627\u0644\u062A\u0641\u0627\u0639\u0644 \u0645\u0639 \u0627\u0644\u0623\u0646\u0634\u0637\u0629
    \u062F\u0627\u062E\u0644 \u0627\u0644\u0645\u0646\u0635\u0629.\n\r\n\u2022\t\u0633\u0646\u0627\u0645:
    \u064A\u0642\u0635\u062F \u0628\u0647\u0627:\r\n1-\t\u0627\u0644\u0646\u0633\u062E\u0629
    \u0627\u0644\u062E\u0627\u0635\u0629 \u0628\u0640 2025 \u0645\u0646 \u0645\u0646\u0635\u0629
    \u0631\u0627\u0639\u064A \u0627\u0644\u0646\u0638\u0631.\r\n2-\t\u0627\u0644\u0639\u0645\u0644\u0629
    \u0627\u0644\u0627\u0641\u062A\u0631\u0627\u0636\u064A\u0629 \u062F\u0627\u062E\u0644
    \"\u0627\u0644\u0645\u0646\u0635\u0629 \"\u060C \u0648\u0627\u0644\u062A\u064A
    \u062A\u064F\u0633\u062A\u062E\u062F\u0645 \u0644\u062A\u0641\u0639\u064A\u0644
    \u0645\u0632\u0627\u064A\u0627 \u062F\u0627\u062E\u0644\u064A\u0629\u060C \u0623\u0648
    \u0634\u0631\u0627\u0621 \u062F\u0627\u062E\u0644 \u0627\u0644\u0645\u0646\u0635\u0629\u060C
    \u0648\u064A\u062A\u0645 \u0627\u0644\u062D\u0635\u0648\u0644 \u0639\u0644\u064A\u0647\u0627
    \u0639\u0628\u0631 \u0639\u062F\u0629 \u0637\u0631\u0642 \u0645\u0646\u0647\u0627
    \u0639\u0644\u0649 \u0633\u0628\u064A\u0644 \u0627\u0644\u0645\u062B\u0627\u0644
    \u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0627\u0644\u0645\u0642\u0627\u0645\u0629
    \u062F\u0627\u062E\u0644 \u0648\u062E\u0627\u0631\u062C \u0627\u0644\u0644\u0639\u0628\u0629\u060C
    \u0648\u064A\u0645\u0643\u0646 \u0634\u0631\u0627\u0626\u0647\u0627 \u0645\u0646
    \u0627\u0644\u0645\u062A\u062C\u0631 \u0627\u0644\u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A
    \u062F\u0627\u062E\u0644 \u0627\u0644\u0645\u0646\u0635\u0629.\r\n\u2022\t\u0627\u0644\u0646\u0642\u0627\u0637:
    \u062A\u064F\u0633\u062A\u062E\u062F\u0645 \u0644\u062A\u0642\u064A\u064A\u0645
    \u0627\u0644\u0623\u062F\u0627\u0621\u060C \u0648\u0627\u0644\u062A\u0631\u062A\u064A\u0628
    \u0641\u064A \u0644\u0648\u0627\u0626\u062D \u0627\u0644\u0645\u062A\u0635\u062F\u0631\u064A\u0646\u060C
    \u0623\u0648 \u0627\u0644\u062A\u0642\u062F\u0645 \u0625\u0644\u0649 \u0645\u0633\u062A\u0648\u064A\u0627\u062A
    \u0623\u0639\u0644\u0649 \u0628\u062D\u0633\u0628 \u0637\u0628\u064A\u0639\u0629
    \u0627\u0644\u062A\u062D\u062F\u064A\u060C \u0648\u064A\u062D\u0635\u0644 \u0639\u0644\u064A\u0647\u0627
    \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645 \u0639\u0628\u0631 \u0639\u062F\u0629
    \u0637\u0631\u0642 \u0645\u0646\u0647\u0627 \u0639\u0644\u0649 \u0633\u0628\u064A\u0644
    \u0627\u0644\u0645\u062B\u0627\u0644 (\u062A\u0646\u0641\u064A\u0630 \u0627\u0644\u0623\u0646\u0634\u0637\u0629
    \u062F\u0627\u062E\u0644 \u0627\u0644\u0645\u0646\u0635\u0629\u060C \u0634\u0631\u0627\u0621
    \u0627\u0644\u0645\u0646\u062A\u062C\u0627\u062A \u062F\u0627\u062E\u0644 \u0627\u0644\u0645\u0646\u0635\u0629\u060C
    \u062A\u0648\u0642\u0639\u0627\u062A \u0627\u0644\u0645\u064A\u062F\u0627\u0646\u060C
    \u062F\u0639\u0645 \u0627\u0644\u0645\u062A\u0633\u0627\u0628\u0642\u064A\u0646).\r\n\r\n\u2022\t\u0623\u0648\u0644\u0627\u064B:
    \u0634\u0631\u0648\u0637 \u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u062D\u0633\u0627\u0628:\r\n1.\t\u064A\u062C\u0628
    \u0623\u0646 \u064A\u062A\u062C\u0627\u0648\u0632 \u0639\u0645\u0631 \u0627\u0644\u0645\u0633\u062C\u0644
    7  \u0633\u0646\u0648\u0627\u062A.\r\n2.\t\u064A\u062C\u0628 \u0639\u0644\u064A\u0643
    \u0627\u0644\u062A\u0633\u062C\u064A\u0644 \u0641\u064A \u0627\u0644\u0645\u0646\u0635\u0629
    \u0644\u0643\u064A \u062A\u062A\u0645\u0643\u0646 \u0645\u0646 \u0627\u0644\u0627\u0633\u062A\u0641\u0627\u062F\u0629
    \u0645\u0646 \u0623\u0646\u0634\u0637\u062A\u0647\u0627 \u0648\u0642\u062F \u064A\u0633\u062A\u062B\u0646\u0649
    \u0645\u0646 \u0630\u0644\u0643 \u0628\u0639\u0636 \u0627\u0644\u0623\u0646\u0634\u0637\u0629
    \u0627\u0644\u062A\u064A \u064A\u0645\u0643\u0646 \u0627\u0644\u0627\u0633\u062A\u0641\u0627\u062F\u0629
    \u0645\u0646\u0647\u0627 \u062F\u0648\u0646 \u062A\u0633\u062C\u064A\u0644\u060C
    \u0648\u064A\u0644\u0632\u0645\u0643 \u0644\u0625\u062A\u0645\u0627\u0645 \u0639\u0645\u0644\u064A\u0629
    \u0627\u0644\u062A\u0633\u062C\u064A\u0644 \u062A\u0639\u0628\u0626\u0629 \u0627\u0644\u0628\u064A\u0627\u0646\u0627\u062A
    \u0628\u0634\u0643\u0644 \u062F\u0642\u064A\u0642: \u0643\u062A\u0627\u0628\u0629
    \u0627\u0644\u0627\u0633\u0645 \u0648\u0631\u0642\u0645 \u0627\u0644\u062C\u0648\u0627\u0644\u060C
    \u0648\u0623\u064A \u0645\u0639\u0644\u0648\u0645\u0629 \u0645\u0637\u0644\u0648\u0628\u0629
    \u0643\u0645\u0627 \u0647\u0648 \u0645\u0648\u0636\u062D \u0641\u064A \u0635\u0641\u062D\u0629
    \u0627\u0644\u062A\u0633\u062C\u064A\u0644.\r\n3.\t\u064A\u062D\u0642 \u0644\u0644\u0645\u0646\u0635\u0629
    \u0628\u0645\u0648\u062C\u0628 \u0627\u0644\u0635\u0644\u0627\u062D\u064A\u0627\u062A
    \u0627\u0644\u0645\u0645\u0646\u0648\u062D\u0629 \u0644\u0647\u0627 \u0641\u064A
    \u0647\u0630\u0647 \u0627\u0644\u0627\u062A\u0641\u0627\u0642\u064A\u0629 \u0631\u0641\u0636
    \u0637\u0644\u0628 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u062D\u0633\u0627\u0628
    \u0648\u0644\u064A\u0633 \u0639\u0644\u064A\u0647\u0627 \u062A\u0628\u0631\u064A\u0631
    \u0633\u0628\u0628 \u0627\u0644\u0631\u0641\u0636\u060C \u0643\u0645\u0627 \u064A\u062D\u0642
    \u0625\u0644\u063A\u0627\u0621 \u0623\u0648 \u062A\u0639\u0637\u064A\u0644 \u0627\u0644\u062D\u0633\u0627\u0628
    \u0623\u0648 \u0645\u0646\u0639\u0647 \u0645\u0646 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629
    \u0641\u064A \u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0641\u064A \u0623\u064A
    \u0648\u0642\u062A \u0645\u062A\u0649 \u0645\u0627 \u062A\u0628\u064A\u0646 \u0623\u0646
    \u0645\u0627\u0644\u0643 \u0627\u0644\u062D\u0633\u0627\u0628 \u0642\u062F \u062F\u0648\u0651\u0646
    \u0645\u0639\u0644\u0648\u0645\u0627\u062A \u062E\u0627\u0637\u0626\u0629 \u0648\u063A\u064A\u0631
    \u0635\u062D\u064A\u062D\u0629 \u0623\u0648 \u062A\u0628\u064A\u0646 \u0644\u0647\u0627
