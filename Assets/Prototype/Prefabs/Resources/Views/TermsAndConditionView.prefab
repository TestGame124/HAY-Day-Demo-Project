    \u0623\u0648 \u0641\u064A \u062D\u0627\u0644 \u0634\u0643\u0651\u062A \u0627\u0644\u0645\u0646\u0635\u0629
    \u0628\u0648\u062C\u0648\u062F \u062A\u0644\u0627\u0639\u0628.\r\n4.\t\u0644\u0627
    \u064A\u062D\u0642 \u0644\u0644\u0645\u0633\u062A\u062E\u062F\u0645 \u0627\u0644\u0627\u0639\u062A\u0631\u0627\u0636
    \u0639\u0644\u0649 \u0623\u064A\u0651 \u0645\u0646 \u0642\u0631\u0627\u0631\u0627\u062A
