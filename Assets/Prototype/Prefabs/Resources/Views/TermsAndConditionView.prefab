    \u0627\u0644\u0631\u0633\u0645\u064A\u0629 \u0627\u0644\u0623\u062E\u0631\u0649.\r\n3.\t\u064A\u062D\u0642
    \u0644\u0644\u0645\u0646\u0635\u0629 \u062D\u062C\u0628 \u0646\u0642\u0627\u0637
