    \u0639\u0628\u0631 \u0627\u0644\u0642\u0646\u0648\u0627\u062A \u0627\u0644\u0645\u062D\u062F\u062F\u0629\u060C
    \u062A\u0634\u0645\u0644 \u0627\u0644\u0625\u0641\u0627\u062F\u0629 \u0628\u064A\u0627\u0646\u0627\u062A
    \u062A\u0639\u0631\u064A\u0641\u064A\u0629 \u0644\u0627\u0632\u0645\u0629 \u0644\u0644\u062A\u062D\u0642\u0642
    \u0645\u0646 \u0627\u0644\u0623\u0647\u0644\u064A\u0629 \u0648\u0627\u0644\u062C\u0648\u0627\u0626\u0632
    (\u0645\u062B\u0644 \u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0631\u0628\u0627\u0639\u064A
