    \u0627\u0644\u062D\u0645\u0627\u0633 \u0628\u064A\u0646 \u0627\u0644\u0645\u062A\u0646\u0627\u0641\u0633\u064A\u0646.\r\n7.\t\u064A\u0644\u062A\u0632\u0645
