    \u0628\u0623\u064A \u0637\u0631\u064A\u0642\u0629 \u063A\u064A\u0631 \u0645\u0634\u0631\u0648\u0639\u0629
    \u0623\u0648 \u0641\u064A\u0647\u0627 \u0627\u0646\u062A\u0647\u0627\u0643 \u0623\u0648
    \u062A\u0639\u062F\u064A.\r\n6.\t\u064A\u062D\u0642 \u0644\u0644\u0645\u0646\u0635\u0629
    \u0627\u0633\u062A\u062D\u062F\u0627\u062B \u0623\u064A \u0627\u062C\u0631\u0627\u0621
