    \u0648\u0623\u0646\u0647 \u0627\u0634\u062A\u0631\u0649 \u0647\u0630\u0647 \u0627\u0644\u0628\u0627\u0642\u0627\u062A
    \u0648\u0627\u0644\u0645\u0646\u062A\u062C\u0627\u062A \u0645\u0639 \u0639\u0644\u0645\u0647
