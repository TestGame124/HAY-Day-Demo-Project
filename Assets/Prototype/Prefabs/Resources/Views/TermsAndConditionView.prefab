    \u0648\u0625\u0644\u063A\u0627\u0621 \u062D\u0633\u0627\u0628 \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645
    \u0648\u0645\u0646\u0639\u0647 \u0645\u0646 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629
    \u0641\u064A \u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0641\u064A \u062D\u0627\u0644
